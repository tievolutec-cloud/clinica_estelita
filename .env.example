# Copie estas variáveis para Vercel > Project Settings > Environment Variables.
# Nunca coloque chaves reais dentro do GitHub.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Preferencial nas versões atuais do Supabase:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_PUBLICA

# Compatibilidade com projetos que ainda exibem a chave anon antiga:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA_ANON

# Opcional: URL pública do sistema depois do deploy
NEXT_PUBLIC_APP_URL=https://seu-dominio.vercel.app
